@model IEnumerable<WebAppFront_end.Models.Dtos.Usuario.SocioListadoDTO>

<div class="container mt-4">
    <h1 class="mb-4">Lista de Socios que usaron el Telescopio</h1>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre del Socio</th>
                        <th>Email del Socio</th>
                        <th>Telefono del Socio</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td>@u.Nombre</td>
                            <td>@u.Email</td>
                            <td>@u.Telefono</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info shadow-sm" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i> No se encontraron socios que hayan utilizado este telescopio.
        </div>
    }

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>
</div>