@model WebAppFront_end.Models.VM.VMPrestamo


<h1>Alta Prestamo</h1>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="AltaPrestamo" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Socio" class="control-label"></label>
                <select asp-for="Socio" class="form-control">
                <option value="">Seleccione un socio</option>
                @foreach (var u in Model.listUsuarios)
                {
                    <option value="@u.Id">
                        @u.Nombre
                    </option>
                }
                </select>
                <span asp-validation-for="Socio" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Telescopio" class="control-label"></label>
                <select id="telescopioSelect" asp-for="Telescopio" class="form-control">
                    <option value="">Seleccione un telescopio</option>
                    @foreach (var t in Model.listTelescopios)
                    {
                        <option value="@t.Id">
                            @t.Marca
                        </option>
                    }
                </select>
                <span asp-validation-for="Telescopio" class="text-danger"></span>
                <div id="mensajeTelescopio" class="text-danger"></div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Montura" class="control-label"></label>
                <select id="monturaSelect" asp-for="Montura" class="form-control">
                    <option value="">Seleccione una montura</option>
                    @foreach (var t in Model.listMonturas)
                    {
                        <option value="@t.Id">
                            @t.Marca
                        </option>
                    }
                </select>
                <span asp-validation-for="Montura" class="text-danger"></span>
                <div id="mensajeMontura" class="text-danger"></div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Camara" class="control-label"></label>
                <select id="camaraSelect" asp-for="Camara" class="form-control">
                    <option value="">Seleccione una Camara</option>
                    @foreach (var t in Model.listCamaras)
                    {
                        <option value="@t.Id">
                            @t.Marca
                        </option>
                    }
                </select>
                <span asp-validation-for="Camara" class="text-danger"></span>
                <div id="mensajeCamara" class="text-danger"></div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Ocular" class="control-label"></label>
                <select id="ocularSelect" asp-for="Ocular" class="form-control">
                    <option value="">Seleccione un Ocular</option>
                    @foreach (var t in Model.listOculares)
                    {
                        <option value="@t.id">
                            @t.Marca
                        </option>
                    }
                </select>
                <span asp-validation-for="Ocular" class="text-danger"></span>
                <div id="mensajeOcular" class="text-danger"></div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FchInicio" class="control-label"></label>
                <input asp-for="FchInicio" class="form-control" type="date" />
                <span asp-validation-for="FchInicio" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FchFin" class="control-label"></label>
                <input asp-for="FchFin" class="form-control" type="date" />
                <span asp-validation-for="FchFin" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input id="btnSubmit"
                       type="submit"
                       value="Crear"
                       class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Admin" asp-action="Index">
        Volver
    </a>
</div>
<script>
    async function verificar(selectId, mensajeId)
    {
        const select = document.getElementById(selectId);
        const mensaje = document.getElementById(mensajeId);
        const id = select.value;

        if (!id)
        {
            mensaje.innerText = "";
            return;
        }
        try
        {
                const myHeaders = new Headers();
                myHeaders.append("Authorization", "@ViewBag.Token");
                
                    const requestOptions = {
                      method: "GET",
                      headers: myHeaders,
                      redirect: "follow"
                    };

                const response = await fetch(`https://localhost:7027/api/Admin/equipos/${id}`, requestOptions);

            if (!response.ok)
            {
                mensaje.innerText = "Error al consultar API";
                return;
            }
            const data = await response.json();
            //ToDo falta verificar si el equipo esta en estado en Prestamo
                if (data.cantidad <= 0)
                {
                    mensaje.innerText = "No hay Stock para este equipo";
                }
                else if (data.cantidad === 1)
                {
                    mensaje.innerText = "Ultimo equipo Disponible (solo queda 1)";
                    mensaje.className = "text-warning";
                }
                else
                {
                    mensaje.innerText = "";
                }
        }
        catch(error)
        {
            console.error(error);
            mensaje.innerText = "Error de conexión";
        }
    }
    /*despues que cargue el DOM, y cuando hayan cambios en los select chequea si hay stock en los equipos*/
    document.addEventListener("DOMContentLoaded", () => {

        document.getElementById("telescopioSelect")
            .addEventListener("change", () =>
                verificar("telescopioSelect", "mensajeTelescopio"));

        document.getElementById("monturaSelect")
            .addEventListener("change", () =>
                verificar("monturaSelect", "mensajeMontura"));

        document.getElementById("camaraSelect")
            .addEventListener("change", () =>
                verificar("camaraSelect", "mensajeCamara"));

        document.getElementById("ocularSelect")
            .addEventListener("change", () =>
                verificar("ocularSelect", "mensajeOcular"));
    });
</script>