@model WebAppFront_end.Models.VM.Equipo.VMMontura
<h1>Agregar Montura en el Sistema</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="AltaMontura">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Marca" class="control-label"></label>
                <br />
                <span asp-validation-for="Marca" class="text-danger"></span>
                <input asp-for="Marca" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="Modelo" class="control-label"></label>
                <br />
                <span asp-validation-for="Modelo" class="text-danger"></span>
                <input asp-for="Modelo" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="Cantidad" class="control-label"></label>
                <br />
                <span asp-validation-for="Cantidad" class="text-danger"></span>
                <input asp-for="Cantidad" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="TipoMontura" class="control-label"></label>
                <br />
                <span asp-validation-for="TipoMontura" class="text-danger"></span>
                <select asp-for="TipoMontura" class="form-control">
                    <option value="Ecuatorial">Ecuatorial</option>
                    <option value="AltAzimutal">AltAzimutal</option>
                    <option value="Hibrida">Hibrida</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="CargaSoportada" class="control-label"></label>
                <br />
                <span asp-validation-for="CargaSoportada" class="text-danger"></span>
                <input asp-for="CargaSoportada" class="form-control" />
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="EsComputarizado" /> @Html.DisplayNameFor(model => model.EsComputarizado)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Crear" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}
<br />
<div>
    <a asp-action="Index">Volver</a>
</div>

