@model WebAppFront_end.Models.VM.VMObservacion

<h2>Alta de observación</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}
<form method="post" asp-action="AltaObservacion">

    <input asp-for="PrestamoId" type="hidden" />

    <div class="mb-3">
        <label>Objeto celeste</label>
        <br />
        <span asp-validation-for="ObjCelesteId"
              class="text-danger"></span>
        <select asp-for="ObjCelesteId" class="form-control">
            <option value="">Seleccione un objeto celeste</option>
            @foreach (var o in ViewBag.ObjetosCelestes)
            {
                <option value="@o.Id">@o.Nombre</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label>Fecha de observación</label>
        <br />
        <span asp-validation-for="FechaObservacion"
              class="text-danger"></span>
        <input asp-for="FechaObservacion"
               type="date"
               class="form-control" />
    </div>

    <button type="submit"
            name="accion"
            value="registrar"
            class="btn btn-primary">
        Registrar observación
    </button>

    <button type="submit"
            formaction="@Url.Action("EvaluarObservacion")"
            class="btn btn-warning">
        Evaluar
    </button>
</form>
@if (ViewBag.ResultadoIA != null)
{
    <div class="alert alert-info mt-3">
        <strong>@ViewBag.ResultadoIA.IndicadorIA</strong>
        <br />
        @ViewBag.ResultadoIA.DetalleIA
    </div>
}
<div class="mt-3">
    <a asp-action="IndexSocio" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Volver
    </a>
</div>